# DashScope API Configuration for Partitioner, Planner and Pi Instances (qwen3.8-flash)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
# Optional role-specific model overrides (uncomment only to force an override over UI settings):
# PLANNER_MODEL=openai/gpt-4o
# PARTITIONER_MODEL=openai/gpt-4o
# NODE_AGENT_MODEL=openai/gpt-4o

# Host-native execution reuses PATH, HOME and TMPDIR.
# File tools and literal bash project paths map to each node's isolated cwd.
# macOS sandbox-exec protects source, sibling workspaces and other sessions.
# PI_CODING_AGENT_DIR=/absolute/path/to/dedicated/pi-agent
# Existing ~/.pi/agent credentials are not copied; log in through Grapher or npm run pi.

# Optional: Override system prompts (bypasses Pi default coding assistant prompt)
# PARTITIONER_SYSTEM_PROMPT=Choose graph only when multiple substantial workstreams can independently progress; otherwise serial. Output one word: graph or serial. Do not solve the task.
# PLANNER_SYSTEM_PROMPT=Compile the following goal into a complete executable work graph using only node, edge, read, bash...
