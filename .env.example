# Optional local configuration. Copy to .env; never commit real credentials.
# Grapher's primary provider login is via Settings or `npm run pi`.
# Pi can also use supported provider environment variables (e.g. OPENAI_API_KEY).
# OPENAI_API_KEY=replace_with_your_own_key

# Optional role overrides. By default roles follow the model selected in Settings.
# PARTITIONER_MODEL=openai/example-model
# PLANNER_MODEL=openai/example-model
# NODE_AGENT_MODEL=openai/example-model
# MERGER_MODEL=openai/example-model

# Local backend port; frontend dev proxy must use the same value.
# GRAPHER_PORT=1421
# PI_CODING_AGENT_DIR=/absolute/path/to/dedicated/pi-agent
# Global Pi extensions, skills and MCP config (default: ~/.pi/agent).
# GRAPHER_GLOBAL_PI_AGENT_DIR=/absolute/path/to/global/pi-agent
# Do NOT set GRAPHER_ALLOWED_ORIGINS unless you understand the local API risk.
