{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B010 planning-quality-v1 summary (not the retired execution benchmark)",
  "type": "object",
  "required": ["schemaVersion", "benchmarkCaseId", "variant", "corpusVersion", "benchmarkRunId", "status", "routing", "planner", "nodeExecutionCount", "results"],
  "properties": {
    "schemaVersion": {"const": 2},
    "benchmarkCaseId": {"const": "B010"},
    "variant": {"const": "planning-quality-v1"},
    "corpusVersion": {"type": "string"},
    "benchmarkRunId": {"type": "string"},
    "status": {"enum": ["PASS", "FAIL"]},
    "nodeExecutionCount": {"const": 0},
    "routing": {
      "type": "object",
      "required": ["total", "correct", "protocolCorrect", "accuracy", "confusion"],
      "properties": {"accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
    },
    "planner": {
      "type": "object",
      "required": ["expected", "compiled", "assessed", "qualityPass", "averageScore", "missingJudgments"],
      "properties": {"averageScore": {"type": ["number", "null"], "minimum": 0, "maximum": 10}}
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskId", "sample", "expectedRoute", "actualRoute", "routeStatus", "routingProtocolStatus", "compilerStatus", "status", "failures", "nodeExecutionCount"],
        "properties": {
          "taskId": {"type": "string", "pattern": "^P00[1-6]$"},
          "sample": {"type": "integer", "minimum": 1},
          "expectedRoute": {"enum": ["serial", "graph"]},
          "actualRoute": {"type": ["string", "null"]},
          "routeStatus": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "routingProtocolStatus": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "compilerStatus": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_RUN"]},
          "planningBoundary": {
            "type": "object",
            "required": ["status", "policy", "issues"],
            "properties": {
              "status": {"enum": ["PASS", "FAIL"]},
              "policy": {"type": "string"},
              "issues": {"type": "array", "items": {"type": "string"}}
            }
          },
          "nodeExecutionCount": {"const": 0}
        }
      }
    }
  }
}
