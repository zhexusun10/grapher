{
  "name": "grapher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-port.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "predesktop": "node scripts/free-port.mjs",
    "desktop": "node scripts/tauri-runner.mjs dev",
    "desktop:build": "node scripts/tauri-runner.mjs build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --features fixture",
    "check": "tsc --noEmit",
    "benchmark": "node benchmark/run.mjs",
    "benchmark:validate": "node benchmark/validate.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@xyflow/react": "12.8.5",
    "lucide-react": "0.468.0",
    "motion": "^13.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.20.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
