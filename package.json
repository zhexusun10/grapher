{
  "name": "grapher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "cargo test --manifest-path backend/Cargo.toml --no-default-features --features fixture",
    "check": "tsc --noEmit",
    "benchmark": "node benchmark/run.mjs",
    "benchmark:validate": "node benchmark/validate.mjs",
    "benchmark:planner": "node benchmark/run.mjs --planner-only",
    "benchmark:runtime": "node benchmark/runtime.mjs",
    "test:benchmark": "node --test benchmark/planning-grade.test.mjs benchmark/planning-boundary.test.mjs scripts/planning-inspection.test.mjs",
    "frontend": "vite --host 127.0.0.1",
    "backend": "cargo run --manifest-path backend/Cargo.toml --bin grapher",
    "start": "cargo run --release --manifest-path backend/Cargo.toml --bin grapher",
    "test:http": "npm run build && cargo build --manifest-path backend/Cargo.toml --features fixture --bin grapher && node scripts/test-http.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.8.5",
    "lucide-react": "0.468.0",
    "motion": "^13.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
