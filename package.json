{
  "name": "grapher",
  "version": "1.8.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test:list": "node scripts/test.mjs --list",
    "test:inventory": "node scripts/test.mjs --check",
    "test:scripts": "node scripts/test.mjs scripts",
    "pi:verify": "node scripts/pi-baseline.mjs verify",
    "test:pi": "node scripts/test.mjs pi",
    "pi:upgrade-check": "npm run pi:verify && npm run pi:build && npm run test:pi && npm run check && npm run test:backend && npm run test:extensions && npm run test:native && npm run test:prewarm && npm run test:bindings",
    "pi:setup": "node scripts/pi-baseline.mjs setup",
    "pi:build": "node scripts/pi-baseline.mjs build",
    "pi:adopt": "node scripts/adopt-pi.mjs",
    "pi": "node engine/entrypoint.mjs",
    "test:native": "node scripts/test.mjs native",
    "test:native:scripts": "node scripts/test.mjs native:scripts",
    "test:prewarm": "node scripts/test.mjs prewarm",
    "probe:prewarm": "node scripts/probe-prewarm.mjs",
    "probe:frontend-performance": "node scripts/node-ts.mjs scripts/probe-frontend-performance.ts",
    "test:merger": "node scripts/test.mjs merger",
    "test:planner-bash": "node scripts/test.mjs planner-bash",
    "test:macos-browser": "node scripts/test.mjs macos-browser",
    "test:environment": "node scripts/test.mjs environment",
    "test:environment-chain": "node scripts/test.mjs environment-chain",
    "test:hardening": "node scripts/test.mjs hardening",
    "test:windows-native": "node scripts/test.mjs windows-native",
    "test:bindings": "node scripts/test.mjs bindings",
    "test:extensions": "node scripts/test.mjs extensions",
    "dev": "node scripts/dev.mjs",
    "cleanup:workspaces": "node scripts/cargo.mjs run --manifest-path backend/Cargo.toml --bin grapher -- --cleanup-workspaces",
    "clean:stale": "node scripts/clean-stale-artifacts.mjs",
    "compact": "node scripts/cargo.mjs run --manifest-path backend/Cargo.toml --bin grapher -- --compact",
    "migrate": "node scripts/cargo.mjs run --manifest-path backend/Cargo.toml --bin grapher -- --migrate",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:frontend": "node scripts/test.mjs frontend",
    "test:ui": "node scripts/test.mjs ui",
    "test:ui-polish": "node scripts/test.mjs ui-polish",
    "test:bundle": "node scripts/test.mjs bundle",
    "test:conversation-acceptance": "node scripts/test.mjs conversation-acceptance",
    "test:concurrent": "node scripts/test.mjs concurrent",
    "test:build-cache": "node scripts/test.mjs build-cache",
    "test:release": "node scripts/test.mjs release",
    "test:isolated": "node scripts/temporary-target.mjs --npm-script test:backend",
    "test:temporary": "node scripts/temporary-target.mjs --npm-script",
    "test:backend": "node scripts/test.mjs backend",
    "frontend": "vite --host 127.0.0.1",
    "backend": "node scripts/cargo.mjs run --manifest-path backend/Cargo.toml --bin grapher",
    "start": "node scripts/cargo.mjs run --release --manifest-path backend/Cargo.toml --bin grapher"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@xyflow/react": "12.8.5",
    "clsx": "^2.1.1",
    "katex": "^0.18.10",
    "lucide-react": "0.468.0",
    "marked": "^18.0.13",
    "motion": "^13.2.0",
    "pi-better-web-search": "0.1.11",
    "pi-continuity": "0.5.0",
    "pi-trim": "0.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "undici": "8.12.3"
  }
}
