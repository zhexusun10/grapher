{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grapher",
  "version": "0.1.0",
  "identifier": "dev.grapher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Grapher", "width": 1440, "height": 940, "minWidth": 1000, "minHeight": 720 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/128x128.png"], "resources": ["resources/*"] }
}
