.env*
!.env.example
*.pem
*.p12
*.pfx
*.key

# Grapher runtime and Rust outputs
backend/target*/
target*/
.grapher/
.grapher-verify*/
.grapher-path-audit/
.pi/
.agents/skills/

# Python
.venv/
venv/
__pycache__/
*.pyc

# Local Windows launcher scripts
start.bat
scripts/launch.ps1
